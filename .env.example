# ==============================================================================
# VietMeeting AI - Cấu hình môi trường mẫu (.env.example)
# Đổi tên file này thành .env và điền GEMINI_API_KEY của bạn vào
# ==============================================================================

# Backend FastAPI
PORT=8000
HOST=0.0.0.0

# Công cụ AI ưu tiên: "gemini" (Khuyến nghị - Nhanh 10-20s) hoặc "local" (Chạy mô hình nội bộ)
PREFERRED_AI_ENGINE=gemini

# Google Gemini API Key (Lấy miễn phí tại: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
